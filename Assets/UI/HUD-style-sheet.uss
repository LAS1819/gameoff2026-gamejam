VisualElement {}

#hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

#inventory-panel {
    position: absolute;
    left: 50%;
    bottom: 24px;
    translate: -50% 0;
    flex-direction: row;
}

.inventory-slot {
    width: 64px;
    height: 64px;
    margin-right: 12px;
    justify-content: center;
    align-items: center;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
}

.inventory-slot.full {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.6);
}

.inventory-slot.selected {
    background-color: rgba(255, 214, 102, 0.22);
    border-color: rgba(255, 214, 102, 0.9);
}

.slot-label {
    color: rgba(255, 255, 255, 0.95);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

#feedback-text {
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -50% 0;
    opacity: 0;
    transition: opacity 0.2s ease;
}

#feedback-text.visible {
    opacity: 1;
}

#shift-button {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    z-index: 1;
}

#lantern-icon {
    position: absolute;
    right: 24px;
    bottom: 72px;
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 1;
    z-index: 2;
    pointer-events: none;
    background-image: url("project://database/Assets/Visuals/UI/spritesheet-ui-icon-lantern-v1.png#spritesheet-ui-icon-lantern-v1_0");
}

.shift-button {
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 0;
    margin: 0;
    -unity-background-scale-mode: scale-to-fit;
    cursor: link;
}

.shift-button:hover {
    opacity: 0.9;
}

.shift-button:active {
    opacity: 0.75;
}

.shift-button:disabled {
    opacity: 0.35;
}

.shift-button.normal {
    background-image: url("project://database/Assets/Visuals/UI/shift-icon-hooded-figure-normal-world.png");
}

.shift-button.other-side {
    background-image: url("project://database/Assets/Visuals/UI/shift-icon-hooded-figure-other-world.png");
}

#transition-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    background-color: rgba(0, 0, 0, 0.7);
    transition: opacity 0.3s ease;
}

#transition-overlay.active {
    opacity: 1;
}

#reality-pulse {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    background-color: rgba(120, 130, 255, 0.18);
    transition: opacity 0.25s ease;
}

#reality-pulse.active {
    opacity: 1;
}

.memory-discovery-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 20;
}

.memory-discovery-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(18, 22, 31, 0.58);
}

.memory-discovery-panel {
    position: relative;
    width: 72%;
    max-width: 620px;
    min-height: 220px;
    max-height: 280px;
    padding: 18px 28px;
    align-items: center;
    justify-content: center;
    background-color: rgba(235, 232, 220, 0.94);
    border-width: 2px;
    border-radius: 10px;
    border-color: rgba(70, 74, 82, 0.72);
}

.memory-discovery-image {
    width: 100%;
    height: 112px;
    margin-bottom: 10px;
    border-radius: 6px;
    background-color: rgba(90, 92, 100, 0.22);
    -unity-background-scale-mode: scale-to-fit;
}

.memory-discovery-eyebrow {
    color: rgba(70, 74, 82, 0.82);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.memory-discovery-title {
    color: rgba(36, 38, 44, 0.98);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 4px;
}

.memory-discovery-body {
    color: rgba(36, 38, 44, 0.92);
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

#story-overlay-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.82);
    pointer-events: none;
}

#story-overlay-panel {
    position: absolute;
    width: 58%;
    max-width: 620px;
    min-width: 420px;
    min-height: 220px;
    max-height: 300px;
    padding: 20px 28px 14px;
    justify-content: space-between;
    background-color: rgba(171, 137, 93, 0.96);
    border-width: 3px;
    border-radius: 12px;
    border-color: rgba(238, 216, 169, 0.72);
    z-index: 1;
}

.story-overlay-eyebrow {
    color: rgba(62, 44, 29, 0.86);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.story-overlay-title {
    color: rgba(48, 35, 25, 0.98);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 6px;
}

.story-overlay-body {
    flex-grow: 1;
    color: rgba(48, 35, 25, 0.98);
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 10px;
    margin-bottom: 54px;
    padding-bottom: 4px;
}

.story-overlay-memory-count {
    color: rgba(48, 35, 25, 0.86);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.story-overlay-credits {
    color: rgba(48, 35, 25, 0.72);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 2px;
    margin-bottom: 54px;
}

.story-overlay-actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 0;
    min-height: 42px;
}

.story-overlay-close,
.story-overlay-restart {
    min-width: 176px;
    height: 42px;
    margin: 0 8px;
    color: rgba(248, 236, 205, 0.98);
    background-color: rgba(70, 52, 36, 0.92);
    border-width: 1px;
    border-color: rgba(238, 216, 169, 0.72);
    border-radius: 6px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
    cursor: link;
}